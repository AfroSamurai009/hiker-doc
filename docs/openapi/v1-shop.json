{
  "openapi": "3.1.0",
  "info": {
    "title": "",
    "version": ""
  },
  "paths": {
    "/v1/shop/about": {
      "get": {
        "summary": "Shop About",
        "description": "Get \"About this shop\": seller name, address, contacts, privacy policy\n\n`user_id` is the pk of the account that owns the shop; a merchant id\n(`17841...`) is accepted too.",
        "operationId": "shop_about_v1_shop_about_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Python",
            "source": "from hikerapi import Client\n\ncl = Client(<ACCESS_KEY>)\nres = await cl.shop_about_v1(user_id=\"23410080\")\n",
            "label": "Python"
          }
        ],
        "required": false
      }
    },
    "/v1/shop/products/by_collection/chunk": {
      "get": {
        "summary": "Shop Products By Collection Chunk",
        "description": "Get a chunk of products of a shop collection\n\n`encoded_collection_id` comes from `collections[]` of\n`/v1/shop/storefront`. The Instagram pagination payload is ~10 KB, too\nlong for a query string, so it is kept server-side and the client gets an\nopaque 64-char `cursor` that lives 24 hours.",
        "operationId": "shop_products_by_collection_chunk_v1_shop_products_by_collection_chunk_get",
        "parameters": [
          {
            "name": "encoded_collection_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Encoded Collection Id"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Use value of the second element of the previous response. The cursor is valid for 24 hours.",
              "title": "Cursor"
            },
            "description": "Use value of the second element of the previous response. The cursor is valid for 24 hours."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ShopProduct"
                      }
                    },
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2,
                  "title": "Response Shop Products By Collection Chunk V1 Shop Products By Collection Chunk Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Python",
            "source": "from hikerapi import Client\n\ncl = Client(<ACCESS_KEY>)\nres = await cl.shop_products_by_collection_chunk_v1(\n    encoded_collection_id=\"all_products:520286110349397:23410080\"\n)\n",
            "label": "Python"
          }
        ],
        "required": false
      }
    },
    "/v1/shop/storefront": {
      "get": {
        "summary": "Shop Storefront",
        "description": "Get shop storefront: merchant ids, collections and first-screen products\n\nA shop exists when `/v2/user/by/username` returns\n`seller_shoppable_feed_type == \"mini_shop_wave_2\"`; an account without a\nshop answers 404 `ShopNotFound`. Use `encoded_collection_id` from\n`collections[]` to page through products. A storefront made of curated\ncollections only can return an empty `products[]` — that is not an error.",
        "operationId": "shop_storefront_v1_shop_storefront_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopStorefront"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Python",
            "source": "from hikerapi import Client\n\ncl = Client(<ACCESS_KEY>)\nres = await cl.shop_storefront_v1(user_id=\"23410080\")\n",
            "label": "Python"
          }
        ],
        "required": false
      }
    }
  },
